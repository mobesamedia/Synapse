# Credentials - never commit these
_secrets.py

# Chromium/Qt browser profiles generated at runtime
ai_v2_profile/
website_web_profile/
music_web_profile/
mindmap_web_data/

# Runtime data files (generated per user, not part of the addon)
addon_settings.json
study_plan_config.json
ai_secrets.json
meta.json

# macOS metadata
.DS_Store
**/.DS_Store
__MACOSX/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local recovery data and Finder custom icons
*.zip
*_backup.json
*_recovery.json
# Finder's custom icon filename ends in a control character (carriage return).
# Do not use Icon?: on case-insensitive systems it also ignores icons/.
Icon[[:cntrl:]]
*.ankiaddon

# IDE folders
.idea/
.vscode/

# Local build artifacts and generated design drafts
/output/

# Add-on user data, SQLite sidecars and fixed pre-update copies
SynapsePro_Data/
*.sqlite
*.sqlite3
*.db
*-wal
*-shm
*-journal
*.pre-block-ui-v1.json*
*.pre-hierarchy-v1.json*
*_backup.json.tmp
*_recovery.json.tmp

